<robot name="exchange_fixture">
  <material name="blue"><color rgba="0.2 0.4 0.8 1"/></material>
  <link name="mount"/>
  <link name="base">
    <inertial><origin xyz="0.01 -0.02 0.03" rpy="0.2 -0.3 0.4"/><mass value="1"/><inertia ixx="0.03" iyy="0.04" izz="0.05" ixy="0.002" ixz="-0.001" iyz="0.003"/></inertial>
    <visual name="shell"><origin xyz="0.03 0 0.02" rpy="0.1 0.2 0.3"/><geometry><box size="0.2 0.1 0.08"/></geometry><material name="blue"/></visual>
    <collision><origin xyz="0.02 0 0"/><geometry><sphere radius="0.04"/></geometry></collision>
  </link>
  <link name="arm">
    <inertial><origin xyz="0.04 0.01 0" rpy="-0.2 0.1 0.3"/><mass value="0.2"/><inertia ixx="0.002" iyy="0.003" izz="0.004" ixy="0.0002" ixz="0" iyz="0.0001"/></inertial>
    <visual><geometry><cylinder radius="0.02" length="0.2"/></geometry></visual>
  </link>
  <link name="carriage"><inertial><mass value="0.1"/><inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/></inertial></link>
  <link name="wheel"><inertial><mass value="0.1"/><inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/></inertial></link>
  <joint name="mount_to_base" type="fixed"><parent link="mount"/><child link="base"/><origin xyz="0.1 0.2 0.3" rpy="0.2 -0.1 0.3"/></joint>
  <joint name="shoulder" type="revolute"><parent link="base"/><child link="arm"/><origin xyz="0.05 0.01 0.08" rpy="0.3 0.2 -0.4"/><axis xyz="0 1 0"/><limit lower="-0.7" upper="1.3" effort="12.5" velocity="2.4"/><dynamics damping="0.03" friction="0.01"/></joint>
  <joint name="slide" type="prismatic"><parent link="arm"/><child link="carriage"/><origin xyz="0.03 0 0" rpy="0.1 0.2 0"/><axis xyz="1 0 0"/><limit lower="-0.05" upper="0.12" effort="7" velocity="0.3"/></joint>
  <joint name="spin" type="continuous"><parent link="base"/><child link="wheel"/><origin xyz="0 -0.1 0.02" rpy="1.5707963267948966 0 0"/><axis xyz="0 0 1"/><limit effort="3" velocity="8"/></joint>
</robot>
