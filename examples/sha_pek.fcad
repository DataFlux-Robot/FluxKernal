;; examples/sha_pek.fcad —— "我想要从上海飞到北京"
;;
;; Mission: SHA(虹桥) -> PEK(首都), great-circle ≈ 1088 km.
;; Requirement: 1300 km range with 45-min reserve, 2 occupants + baggage = 180 kg,
;; MTOW 1500 kg class, electric propulsion unit (EPU) closed from the catalog.
;; Chain: Intent -> point-mass holes -> Breguet check -> param collapse ->
;; decompose -> catalog exact (EPU) -> compose back up.
;; One deliberately impossible expectation (e2x) stays as a REJECTED edge —
;; informative failures are assets, the script continues.

;; ── glossary (nouns must be operationally defined before entering specs) ──
(term aircraft "powered vehicle sustaining controlled atmosphere flight between two points")
(term range "great-circle distance flown with reserves, km")
(term payload "revenue mass carried including crew, kg")
(term mass "structural + systems mass of the object, kg")
(term thermal "heat watts rejected into the cabin air")
(term power "electrical watts drawn from the propulsion bus under load")

;; ── shared medium: cabin air absorbs rejected heat ──
(node cabin-air :role Medium :kind thermal-env
  :spec (medium (capacity (heat_w (<= 400))) (margin 0.1)))

;; ── the demand, contract-native ──
(goal sha-pek :kind aircraft
  :spec (contract
    (goals (r1 "fly Shanghai Hongqiao to Beijing Capital nonstop with reserves"
               :falsifiable t
               :measure "mission sim: range_km vs 1088km great-circle + 45min reserve"
               :terms (range aircraft))
           (p1 "carry two occupants plus baggage" :falsifiable t
               :measure "W&B sheet at MTOW" :terms (payload)))
    (semantics aircraft range payload mass thermal power)
    (assumes (route1 "SHA-PEK great-circle corridor"
                     :bounds ((dist_km (>= 1050) (<= 1120)))))
    (guarantees (gr1 "delivers the mission with reserves"
                     :bounds ((range_km (>= 1300)) (payload_kg (>= 180)))))
    (budget (mass_kg (<= 1500)))
    (effluent (heat_w (<= 150 :medium cabin-air)))
    (forbidden (f1 "flutter below Vd/1.2" :check test)
               (f2 "CG outside envelope" :check inspection))
    (not-responsible "airport ground handling" "ATC routing")
    (time-scale mission)))

;; ── collapse step 1: point-mass model, all key params are holes ──
(refine e1 :in (sha-pek) :out sha-pek-pm :role System :kind point-mass
  :transform (point-mass-model))

;; tier-0 Breguet check with midpoint surrogate values
(eval e2 :target sha-pek-pm :with mission-analysis :fidelity 0
  :expect ((range-margin-km (> 0))))

;; collapse step 2: ground the holes to a concrete design point
;; (sfc 8.333e-6 kg/(N·s) = 0.03 kg/(N·h), typical small aero piston/turbine)
(refine e2b :in (sha-pek-pm) :out sha-pek-pm :kind point-mass
  :transform (param-perturb :values ((mtow 1200) (ff 0.28) (ld 14)
                                     (sfc 0.000008333) (v 95))))

;; concrete re-check against the actual requirement
(eval e2c :target sha-pek-pm :with mission-analysis :fidelity 0
  :expect ((range_km (>= 1300))))

;; deliberately impossible expectation: kept forever as an informative failure
(eval e2x :target sha-pek-pm :with mission-analysis :fidelity 0
  :expect ((range-margin-km (> 999999))))

;; ── decompose into subsystems; contracts flow down ──
(refine e3 :in (sha-pek-pm) :out sha-pek-v1 :role System
  :transform (decompose
    :into (wing epu fuselage avionics)
    :flow-down (
      (wing :budget ((mass_kg ("<=" 260))) :guarantees ((gw1 "wing lifts MTOW at 1.3g" :bounds ((lift_n (">=" 20000)) (mass_kg ("<=" 260))))))
      (epu :budget ((mass_kg ("<=" 320))) :guarantees ((ge1 "electric propulsion unit torque and speed" :bounds ((torque_nm (">=" 50)) (rpm (">=" 2000)) (mass_kg ("<=" 320))))))
      (fuselage :budget ((mass_kg ("<=" 380))) :guarantees ((gf1 "occupant bay and luggage" :bounds ((mass_kg ("<=" 380))))))
      (avionics :budget ((mass_kg ("<=" 40))) :guarantees ((ga1 "dual-channel navigation" :bounds ((mass_kg ("<=" 40)))))))
    ))

;; ── the EPU goal closes directly from the catalog (exact lemma) ──
(exact e4 :target sha-pek-v1/epu :from catalog
  :match "torque_nm>=50 rpm>=2000" :out epu-std)

;; ── compose back up the V right leg ──
(compose e5 :in (sha-pek-v1/wing sha-pek-v1/fuselage sha-pek-v1/avionics epu-std)
  :out sha-pek-design :role System :kind light-aircraft
  :rollup ((range_km (>= 1300))))

;; ══ geometric mockup branch: ground every subsystem as 1:20 scale ══
;; Geometry is an EVALUATION PROJECTION of a node (design v0.1 §1.2): each
;; mockup part is grounded sketch -> revolve/extrude with evidence, then
;; assembled with placements + interference checking. Scale model in PLA/
;; aluminum — the FLIGHT mass budgets stay on the ungrounded design branch;
;; the mockup carries its own gram-scale hard budgets (fail-closed honesty).

(refine e6 :in (sha-pek-design) :out model-0 :kind mockup
  :transform (scale-mockup :ratio 0.05))

(refine e7 :in (model-0) :out model-v1 :role System
  :transform (decompose
    :into (m-fuselage m-wing m-hstab m-fin m-motor)
    :flow-down (
      (m-fuselage :budget ((mass_g ("<=" 500))) :guarantees ((gf1 "fusiform body of revolution" :bounds ((mass_g ("<=" 500)) (length_mm (">=" 290))))))
      (m-wing :budget ((mass_g ("<=" 300))) :guarantees ((gwm "flat-plate wing, high mounted" :bounds ((mass_g ("<=" 300)) (span_mm (">=" 500))))))
      (m-hstab :budget ((mass_g ("<=" 30))) :guarantees ((ghs "flat-plate horizontal stabilizer" :bounds ((mass_g ("<=" 30))))))
      (m-fin :budget ((mass_g ("<=" 10))) :guarantees ((gfn "vertical-plate fin, swept" :bounds ((mass_g ("<=" 10))))))
      (m-motor :budget ((mass_g ("<=" 10))) :guarantees ((gmo "motor cylinder on the nose" :bounds ((mass_g ("<=" 10)))))))
    ))

(refine e10 :in (model-v1/m-fuselage) :out m-fuselage-sk :kind sketch
  :transform (ground-sketch :sketch (sketch (pts (p0 0 0) (p1 9 30) (p2 20 75) (p3 27.5 150) (p4 27 225) (p5 19 280) (p6 11 300) (p7 0 300)) (constraints))))
(refine e11 :in (m-fuselage-sk) :out m-fuselage-solid :kind fuselage
  :transform (revolve :material pla))

(refine e12 :in (model-v1/m-wing) :out m-wing-sk :kind sketch
  :transform (ground-sketch :sketch (sketch (pts (w0 -275 0) (w1 275 0) (w2 275 60) (w3 -275 60)) (constraints))))
(refine e13 :in (m-wing-sk) :out m-wing-solid :kind wing
  :transform (extrude :height 6 :material pla))

(refine e14 :in (model-v1/m-hstab) :out m-hstab-sk :kind sketch
  :transform (ground-sketch :sketch (sketch (pts (h0 -60 0) (h1 60 0) (h2 60 30) (h3 -60 30)) (constraints))))
(refine e15 :in (m-hstab-sk) :out m-hstab-solid :kind hstab
  :transform (extrude :height 4 :material pla))

(refine e16 :in (model-v1/m-fin) :out m-fin-sk :kind sketch
  :transform (ground-sketch :sketch (sketch (pts (f0 0 275) (f1 -30 295) (f2 -30 305) (f3 0 305)) (constraints))))
(refine e17 :in (m-fin-sk) :out m-fin-solid :kind fin
  :transform (extrude :height 3 :material pla))

(refine e18 :in (model-v1/m-motor) :out m-motor-sk :kind sketch
  :transform (ground-sketch :sketch (sketch (pts (q0 0 -12) (q1 6 -12) (q2 6 0) (q3 0 0)) (constraints))))
(refine e19 :in (m-motor-sk) :out m-motor-solid :kind motor
  :transform (revolve :material aluminum))

(compose e20 :in (m-fuselage-solid m-wing-solid m-hstab-solid m-fin-solid m-motor-solid)
  :out sha-pek-model :role System :kind aircraft-mockup
  :transform (assemble :placements ((0 0 0) (0 140 30) (0 285 20) (-1.5 0 25 0 1 0 90) (0 0 0)))
  :rollup ((mass_g (<= 1500))))
