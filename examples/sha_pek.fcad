;; examples/sha_pek.fcad —— "我想要从上海飞到北京"
;;
;; Mission: SHA(虹桥) -> PEK(首都), great-circle ≈ 1088 km.
;; Requirement: 1300 km range with 45-min reserve, 2 occupants + baggage = 180 kg,
;; MTOW 1500 kg class, electric propulsion unit (EPU) closed from the catalog.
;; Chain: Intent -> point-mass holes -> Breguet check -> param collapse ->
;; decompose -> catalog exact (EPU) -> compose back up.
;; One deliberately impossible expectation (e2x) stays as a REJECTED edge —
;; informative failures are assets, the script continues.

;; ── glossary (nouns must be operationally defined before entering specs) ──
(term aircraft "powered vehicle sustaining controlled atmosphere flight between two points")
(term range "great-circle distance flown with reserves, km")
(term payload "revenue mass carried including crew, kg")
(term mass "structural + systems mass of the object, kg")
(term thermal "heat watts rejected into the cabin air")
(term power "electrical watts drawn from the propulsion bus under load")

;; ── shared medium: cabin air absorbs rejected heat ──
(node cabin-air :role Medium :kind thermal-env
  :spec (medium (capacity (heat_w (<= 400))) (margin 0.1)))
;; ── shared medium: DC power bus feeding the fabrication cell ──
(node dc-bus :role Medium :kind dc-bus
  ;; 5500W: the V1 part set (airfoil skins, fuselage shell, bulkheads)
;; puts the honest Σbudget at 4340W; effective capacity 4400 >= load
:spec (medium (capacity (power_w (<= 5500))) (margin 0.2)))

;; ── single-source wing parameters (M1): every wing dimension below is a
;; ── :param/:expr reference — no literal coordinates in the wing branch ──
(params wing ((span 3000) (chord 1500) (height 200)
              (t-skin 2) (spar-h 190) (t-spar 30)
              (rib-chord 720) (rib-h 188) (t-rib 3)))

;; ── the shared print capital (PRSI convergence point) ──
(term printer "unbounded-build-volume FDM capital printer")
(term frame "stiff gantry frame of a machine tool")
(node reference-printer :role Resource :kind unbounded-fdm-printer
  :spec (contract
    (goals (rp1 "print every structural part of this product tree"
                :falsifiable t
                :measure "dfam-print hard gate per printed part"
                :terms (printer frame)))
    (semantics printer frame)
    (assumes (rp-a1 "build volume effectively unbounded (demand-layer promise, not kernel-verifiable)"
                    :bounds ((dim_mm (>= 0)))))
    (guarantees (rp-g1 "prints grounded parts that pass dfam-print"
                       :bounds ((mass_g (<= 100000)))))
    (budget (mass_kg (<= 60)))
    (forbidden (rp-f1 "unattended overnight operation" :check test))
    (not-responsible "filament supply logistics")
    (time-scale fabrication)))

;; the printer develops ITSELF one full round (E1-3 hard rule):
;; frame printed on itself (bootstrap), stepper/board from catalog

;; ── the demand, contract-native ──
(goal sha-pek :kind aircraft
  :spec (contract
    (goals (r1 "fly Shanghai Hongqiao to Beijing Capital nonstop with reserves"
               :falsifiable t
               :measure "mission sim: range_km vs 1088km great-circle + 45min reserve"
               :terms (range aircraft))
           (p1 "carry two occupants plus baggage" :falsifiable t
               :measure "W&B sheet at MTOW" :terms (payload)))
    (semantics aircraft range payload mass thermal power)
    (assumes (route1 "SHA-PEK great-circle corridor"
                     :bounds ((dist_km (>= 1050) (<= 1120)))))
    (guarantees (gr1 "delivers the mission with reserves"
                     :bounds ((range_km (>= 1300)) (payload_kg (>= 180)))))
    (budget (mass_kg (<= 1500)))
    (effluent (heat_w (<= 150 :medium cabin-air)))
    (forbidden (f1 "flutter below Vd/1.2" :check test)
               (f2 "CG outside envelope" :check inspection))
    (not-responsible "airport ground handling" "ATC routing")
    (time-scale mission)))

;; ── collapse step 1: point-mass model, all key params are holes ──
(refine e1 :in (sha-pek) :out sha-pek-pm :role System :kind point-mass
  :transform (point-mass-model))

;; tier-0 Breguet check with midpoint surrogate values
(eval e2 :target sha-pek-pm :with mission-analysis :fidelity 0
  :expect ((range-margin-km (> 0))))

;; collapse step 2: ground the holes to a concrete design point
;; (sfc 8.333e-6 kg/(N·s) = 0.03 kg/(N·h), typical small aero piston/turbine)
(refine e2b :in (sha-pek-pm) :out sha-pek-pm :kind point-mass
  :transform (param-perturb :values ((mtow 1200) (ff 0.28) (ld 14)
                                     (sfc 0.000008333) (v 95))))

;; concrete re-check against the actual requirement
(eval e2c :target sha-pek-pm :with mission-analysis :fidelity 0
  :expect ((range_km (>= 1300))))

;; deliberately impossible expectation: kept forever as an informative failure
(eval e2x :target sha-pek-pm :with mission-analysis :fidelity 0
  :expect ((range-margin-km (> 999999))) :informative t)

;; ── decompose into subsystems; contracts flow down ──
(refine e3 :in (sha-pek-pm) :out sha-pek-v1 :role System
  :transform (decompose
    :into (wing epu fuselage avionics)
    :flow-down (
      (wing :budget ((mass_kg ("<=" 260))) :guarantees ((gw1 "wing lifts MTOW at 1.3g" :bounds ((lift_n (">=" 20000)) (mass_kg ("<=" 260))))))
      (epu :budget ((mass_kg ("<=" 320))) :guarantees ((ge1 "electric propulsion unit torque and speed" :bounds ((torque_nm (">=" 50)) (rpm (">=" 2000)) (mass_kg ("<=" 320))))))
      (fuselage :budget ((mass_kg ("<=" 380))) :guarantees ((gf1 "occupant bay and luggage" :bounds ((mass_kg ("<=" 380))))))
      (avionics :budget ((mass_kg ("<=" 40))) :guarantees ((ga1 "dual-channel navigation" :bounds ((mass_kg ("<=" 40)))))))
    ))

;; ── the EPU goal closes directly from the catalog (exact lemma) ──
(exact e4 :target sha-pek-v1/epu :from catalog
  :match "torque_nm>=50 rpm>=2000" :out epu-std
  :at ((1100 150 216)))

;; ══ wing: ONE instantiate (M3) — the wingbox MECHANISM computes the ══
;; ══ whole family from the parameters: frames, per-part geometry, flow- ══
;; ══ down budgets, rib-count (ceil(span/500), policy-checked), prints.  ══
;; ══ rib-1 stays reserved for the machining branch; everything else     ══
;; ══ terminates on the shared printer.  The 80 hand-written lines are   ══
;; ══ gone — what remains declares INTENT and PARAMETERS.                ══
(instantiate e4a :at (sha-pek-v1/wing) :mechanism wingbox
  :params ((span 3000) (chord 1500) (height 200))
  :printer reference-printer :out wingbox)

;; ── per-layer simulator evidence (E2 matrix) ──
(eval e30 :target sha-pek-v1/wing :with aero-2d :fidelity 1
  :ar 14 :s_m2 3.5 :mass_kg 1200 :cruise_ms 95
  :expect ((ld_ratio (>= 14))))
(eval e31 :target epu-std :with prop-map :fidelity 1
  :torque_nm 50 :rpm 6000 :prop_d_m 0.6)
(eval e32 :target wingbox/rib-1/solid :with beam-fe :fidelity 1 :load_n 800)

;; ── fuselage as a REAL structure, mechanism-grade (V1): the cabin is
;;    ONE lofted shell (cabin section contracting to a tail tip, shelled
;;    to 3mm wall) with inset bulkheads; the empennage rides the tail as
;;    airfoil-section stabilizers.  Both are mechanism entries — every
;;    frame computed, nothing hand-placed.  Avionics still closes
;;    straight from the catalog ("may split or not") ──
(refine e43 :in (sha-pek-v1/fuselage) :out fuselage-v1 :role Component
  :transform (decompose
    :into (fuselage-body empennage seat)
    :flow-down (
      (fuselage-body :budget ((mass_kg ("<=" 200))) :guarantees ((gcs "pressurized-load cabin shell" :bounds ((mass_kg ("<=" 200))))))
      (empennage :budget ((mass_kg ("<=" 30))) :guarantees ((get "stabilizers trim and steady the aircraft" :bounds ((mass_kg ("<=" 30))))))
      (seat :budget ((mass_kg ("<=" 15))) :guarantees ((gst "two occupant seats" :bounds ((mass_kg ("<=" 15)))))))))

;; the shell lofts from the nose (above the wing carry-through box) and
;; tapers aft to the tail tip at y 2150; bulkheads at computed stations
(instantiate e43b :at (fuselage-v1/fuselage-body) :mechanism cabin-fuselage
  :params ((length 2100) (width 800) (height 400) (tail-frac 0.4)
           (x0 1100) (y0 50) (z0 205))
  :printer reference-printer :out fuselage)

;; hstab spans the tail tip; the fin stands on it (rotZ90 frame)
(instantiate e43c :at (fuselage-v1/empennage) :mechanism empennage
  :params ((chord 200) (tc 0.10) (h-span 600) (fin-height 300)
           (x0 800) (y0 2180) (z0 245)
           (fin-x0 1100) (fin-y0 2250) (fin-z0 265))
  :printer reference-printer :out empennage)

(exact e45 :target fuselage-v1/seat :from catalog
  :match "mass_kg<=15" :out seat-std
  :at ((1400 320 214)))
(exact e46 :target sha-pek-v1/avionics :from catalog
  :match "mass_kg<=40" :out av-std
  :at ((1300 100 214)))

;; ── compose the aircraft design (V right leg) ──
;; no range roll-up here: the composed airframe carries no mission
;; evidence of its own — range is verified where the mission model lives
;; (e2c hard expect, and the closed-loop re-check e63 with measured L/D)
(compose e5 :in (wingbox/assembly sha-pek-v1/fuselage
                 fuselage/assembly empennage/assembly seat-std
                 sha-pek-v1/avionics epu-std)
  :out sha-pek-design :role System :kind light-aircraft)

;; ══ production branch: the aircraft design demands a machine tool; the ══
;; ══ GANTRY-MILL archetype (E6-4) develops it; THEN the rib is milled   ══
;; ══ on it (:machine, G2) and the line rolls the process up.            ══
;; the production view of the AIRCRAFT (not its mass roll-up) demands the
;; machine: budget narrows Intent's 1500kg envelope, not the aircraft's
;; flown mass — the mill is not part of the aircraft's weight budget
(refine e5c :in (sha-pek-v1) :out fab-req :role Resource :kind gantry-mill-demand
  :spec (contract (budget (mass_kg (<= 1000)))))
(refine e5d :in (fab-req) :out fab-v1 :role System
  :transform (decompose :template gantry-mill))

;; machine structure: bed / columns / crossbeam / z-head, grounded AT the
;; archetype frames (one gantry layout) and printed by the shared printer
(refine e40 :in (fab-v1/bed) :out bed-sk :kind sketch
  :transform (ground-sketch :sketch (sketch
    (pts (b0 0 0) (b1 1800 0) (b2 1800 800) (b3 0 800)) (constraints))))
(refine e41 :in (bed-sk) :out bed-solid :kind bed
  :transform (extrude :height 60 :material aluminum :at (:frame build)))
(refine e42f :in (bed-solid) :out bed-fil :kind bed
  :transform (fillet :edges all :radius 0.5))
(print e42 :in (bed-fil) :printer reference-printer :out bed-printed)
(refine e40c :in (fab-v1/column-L) :out colL-sk :kind sketch
  :transform (ground-sketch :sketch (sketch
    (pts (l0 0 0) (l1 120 0) (l2 120 800) (l3 0 800)) (constraints))))
(refine e41c :in (colL-sk) :out colL-solid :kind column
  :transform (extrude :height 800 :material aluminum :at (:frame build)))
(refine e42cf :in (colL-solid) :out colL-fil :kind colL
  :transform (fillet :edges all :radius 0.5))
(print e42c :in (colL-fil) :printer reference-printer :out colL-printed)
(refine e40d :in (fab-v1/column-R) :out colR-sk :kind sketch
  :transform (ground-sketch :sketch (sketch
    (pts (l4 0 0) (l5 120 0) (l6 120 800) (l7 0 800)) (constraints))))
(refine e41d :in (colR-sk) :out colR-solid :kind column
  :transform (extrude :height 800 :material aluminum :at (:frame build)))
(refine e42df :in (colR-solid) :out colR-fil :kind colR
  :transform (fillet :edges all :radius 0.5))
(print e42d :in (colR-fil) :printer reference-printer :out colR-printed)
(refine e40e :in (fab-v1/crossbeam) :out beam-sk :kind sketch
  :transform (ground-sketch :sketch (sketch
    (pts (m0 0 0) (m1 2040 0) (m2 2040 140) (m3 0 140)) (constraints))))
(refine e41e :in (beam-sk) :out beam-solid :kind crossbeam
  :transform (extrude :height 160 :material aluminum :at (:frame build)))
(refine e42ef :in (beam-solid) :out beam-fil :kind beam
  :transform (fillet :edges all :radius 0.5))
(print e42e :in (beam-fil) :printer reference-printer :out beam-printed)
(refine e40f :in (fab-v1/z-head) :out head-sk :kind sketch
  :transform (ground-sketch :sketch (sketch
    (pts (n0 0 0) (n1 220 0) (n2 220 220) (n3 0 220)) (constraints))))
(refine e41f :in (head-sk) :out head-solid :kind spindle-head
  :transform (extrude :height 300 :material aluminum :at (:frame build)))
(refine e42ff :in (head-solid) :out head-fil :kind head
  :transform (fillet :edges all :radius 0.5))
(print e42f :in (head-fil) :printer reference-printer :out head-printed)

;; axis modules: rail/screw/servo from the catalog, carriage printed.
;; (explicit decompose per axis — same motion-hardware pattern three times)
(refine e5x :in (fab-v1/x-axis) :out xax-v1 :role Component
  :transform (decompose
    :into (x-rail x-screw x-servo x-carriage)
    :flow-down (
      (x-rail :budget ((mass_kg ("<=" 6))) :guarantees ((gxr "X rail travel" :bounds ((travel_mm (">=" 1700))))))
      (x-screw :budget ((mass_kg ("<=" 0.1))) :guarantees ((gxs "X leadscrew" :bounds ((dia_mm ("=" 8))))))
      (x-servo :budget ((mass_kg ("<=" 2.5))) :guarantees ((gxv "X servo torque" :bounds ((torque_nm (">=" 0.35))))))
      (x-carriage :budget ((mass_kg ("<=" 3))) :guarantees ((gxc "X carriage stiffness" :bounds ((mass_kg ("<=" 1)))))))))
(exact e5xr :target xax-v1/x-rail :from catalog :match "travel_mm>=1700" :out x-rail-std
  :at ((0 2150 40)))
(procure e5xs :target xax-v1/x-screw :from catalog :match "dia_mm=8" :out x-screw-bought
  :at ((60 2080 20)))
(exact e5xv :target xax-v1/x-servo :from catalog :match "torque_nm>=0.35 mass_g<=2500" :out x-servo-std
  :at ((-60 2050 20)))
(refine e5xc1 :in (xax-v1/x-carriage) :out xcar-sk :kind sketch
  :transform (ground-sketch :sketch (sketch
    (pts (u0 0 0) (u1 150 0) (u2 150 120) (u3 0 120)) (constraints))))
(refine e5xc2 :in (xcar-sk) :out xcar-solid :kind carriage
  :transform (extrude :height 80 :material pla :at ((300 -100 60))))
(refine e5xc3f :in (xcar-solid) :out xcar-fil :kind xcar
  :transform (fillet :edges all :radius 0.5))
(print e5xc3 :in (xcar-fil) :printer reference-printer :out xcar-printed)

(refine e5y :in (fab-v1/y-axis) :out yax-v1 :role Component
  :transform (decompose
    :into (y-rail y-screw y-servo y-carriage)
    :flow-down (
      (y-rail :budget ((mass_kg ("<=" 6))) :guarantees ((gyr "Y rail travel" :bounds ((travel_mm (">=" 700))))))
      (y-screw :budget ((mass_kg ("<=" 0.1))) :guarantees ((gys "Y leadscrew" :bounds ((dia_mm ("=" 8))))))
      (y-servo :budget ((mass_kg ("<=" 2.5))) :guarantees ((gyv "Y servo torque" :bounds ((torque_nm (">=" 0.35))))))
      (y-carriage :budget ((mass_kg ("<=" 3))) :guarantees ((gyc "Y carriage stiffness" :bounds ((mass_kg ("<=" 1)))))))))
(exact e5yr :target yax-v1/y-rail :from catalog :match "travel_mm>=700" :out y-rail-std
  :at ((2050 300 40) (0 0 1 90)))
(procure e5ys :target yax-v1/y-screw :from catalog :match "dia_mm=8" :out y-screw-bought
  :at ((1980 60 20) (0 0 1 90)))
(exact e5yv :target yax-v1/y-servo :from catalog :match "torque_nm>=0.35 mass_g<=2500" :out y-servo-std
  :at ((1950 -60 20) (0 0 1 90)))
(refine e5yc1 :in (yax-v1/y-carriage) :out ycar-sk :kind sketch
  :transform (ground-sketch :sketch (sketch
    (pts (v0 0 0) (v1 150 0) (v2 150 120) (v3 0 120)) (constraints))))
(refine e5yc2 :in (ycar-sk) :out ycar-solid :kind carriage
  :transform (extrude :height 80 :material pla :at ((-100 250 60))))
(refine e5yc3f :in (ycar-solid) :out ycar-fil :kind ycar
  :transform (fillet :edges all :radius 0.5))
(print e5yc3 :in (ycar-fil) :printer reference-printer :out ycar-printed)

(refine e5z :in (fab-v1/z-axis) :out zax-v1 :role Component
  :transform (decompose
    :into (z-rail z-screw z-servo z-carriage)
    :flow-down (
      (z-rail :budget ((mass_kg ("<=" 6))) :guarantees ((gzr "Z rail travel" :bounds ((travel_mm (">=" 400))))))
      (z-screw :budget ((mass_kg ("<=" 0.1))) :guarantees ((gzs "Z leadscrew" :bounds ((dia_mm ("=" 8))))))
      (z-servo :budget ((mass_kg ("<=" 2.5))) :guarantees ((gzv "Z servo torque" :bounds ((torque_nm (">=" 0.35))))))
      (z-carriage :budget ((mass_kg ("<=" 3))) :guarantees ((gzc "Z carriage rides the beam" :bounds ((mass_kg ("<=" 1)))))))))
(exact e5zr :target zax-v1/z-rail :from catalog :match "travel_mm>=400" :out z-rail-std
  :at ((2350 0 700) (0 1 0 90)))
(procure e5zs :target zax-v1/z-screw :from catalog :match "dia_mm=8" :out z-screw-bought
  :at ((2280 0 600) (0 1 0 90)))
(exact e5zv :target zax-v1/z-servo :from catalog :match "torque_nm>=0.35 mass_g<=2500" :out z-servo-std
  :at ((2210 0 1320) (0 1 0 90)))
(refine e5zc1 :in (zax-v1/z-carriage) :out zcar-sk :kind sketch
  :transform (ground-sketch :sketch (sketch
    (pts (w0 0 0) (w1 150 0) (w2 150 120) (w3 0 120)) (constraints))))
(refine e5zc2 :in (zcar-sk) :out zcar-solid :kind carriage
  :transform (extrude :height 80 :material pla :at ((-75 70 880))))
(refine e5zc3f :in (zcar-solid) :out zcar-fil :kind zcar
  :transform (fillet :edges all :radius 0.5))
(print e5zc3 :in (zcar-fil) :printer reference-printer :out zcar-printed)

;; spindle + CNC from the catalog
(exact e5e :target fab-v1/spindle :from catalog
  :match "torque_nm>=8 rpm>=12000" :out fab-spindle-std
  :at ((2450 200 60)))
(procure e5f :target fab-v1/cnc :from catalog
  :match "axis_count>=4" :out fab-cnc-bought
  :at ((2500 400 20) (0 0 1 90)))

;; per-axis assemblies: the axis scope's whole terminal set (rail/
;; screw/servo catalog items + the printed carriage) composes back —
;; U4 subtree-assembled; the machine then composes assemblies, not scopes
(compose eax :in (x-rail-std x-screw-bought x-servo-std xcar-printed)
  :out xax-assy :role Component :kind axis-module)
(compose eay :in (y-rail-std y-screw-bought y-servo-std ycar-printed)
  :out yax-assy :role Component :kind axis-module)
(compose eaz :in (z-rail-std z-screw-bought z-servo-std zcar-printed)
  :out zax-assy :role Component :kind axis-module)
;; the machine exists — compose it
(compose e5g :in (bed-solid colL-solid colR-solid beam-solid head-solid
                      xax-assy yax-assy zax-assy fab-spindle-std fab-cnc-bought)
  :out fab-mill :role Resource :kind gantry-mill)

;; NOW the rib is milled ON the developed machine (G2: the machine digest
;; enters the process edges — "this mill machines this part" is a DAG fact)
(manufacture e5a :in (wingbox/rib-1/solid) :out rib-proc :machine fab-mill
  :transform (process-plan :into (stock milling-3axis inspection)))
(compose e5b :in (rib-proc/stock rib-proc/milling-3axis rib-proc/inspection)
  :out rib-line :role Line :kind rib-line
  :transform (line-eval)
  :rollup ((takt_min (<= 65)) (oee (>= 0.5))))

(refine e50 :in (reference-printer) :out printer-v1 :role System
  :transform (decompose
    :into (p-frame p-stepper p-board)
    :flow-down (
      (p-frame :budget ((mass_g ("<=" 6000))) :guarantees ((gpf "stiff gantry frame" :bounds ((mass_g ("<=" 6000))))))
      (p-stepper :budget ((mass_g ("<=" 400))) :guarantees ((gps "extruder stepper torque" :bounds ((torque_nm (">=" 0.35))))))
      (p-board :budget ((mass_g ("<=" 300))) :guarantees ((gpb "4-axis motion board" :bounds ((axis_count (">=" 4)))))))))
(refine e51 :in (printer-v1/p-frame) :out pframe-sk :kind sketch
  :transform (ground-sketch :sketch (sketch
    (pts (r0 0 0) (r1 600 0) (r2 600 600) (r3 0 600)) (constraints))))
(refine e52 :in (pframe-sk) :out pframe-solid :kind frame
  :transform (extrude :height 8 :material pla))
(refine e53f :in (pframe-solid) :out pframe-fil :kind pframe
  :transform (fillet :edges all :radius 0.5))
(print e53 :in (pframe-fil) :printer reference-printer :out pframe-printed)
(exact e54 :target printer-v1/p-stepper :from catalog
  :match "torque_nm>=0.35 mass_g<=400" :out p-stepper-std
  :at ((-60 6350 610)))
(procure e55 :target printer-v1/p-board :from catalog
  :match "axis_count>=4" :out p-board-bought
  :at ((80 6100 608)))
;; the printer's own terminal set composes back (U4): printed frame +
;; catalog stepper/board = the next-generation printer as an assembly
(compose e53c :in (pframe-printed p-stepper-std p-board-bought)
  :out printer-assy :role Resource :kind fdm-printer)

;; ══ mockup: DERIVED from the real subtree (E6-3) — no parallel ══
;; ══ hand-drawn geometry. scale-instance walks every grounded solid  ══
;; ══ under the design (wingbox skins/spars/ribs, cabin, empennage),  ══
;; ══ scales 0.05 and fuses one assembly: what you SEE is what the    ══
;; ══ DAG declares. Closure: one print edge on the shared printer.    ══
(refine e6 :in (sha-pek-design) :out mockup-solid :role Component :kind mockup
  :transform (scale-instance :ratio 0.05 :material pla))
(print e6p :in (mockup-solid) :printer reference-printer :out mockup-printed)

;; ── closed-loop re-verification (V-model right leg): assembly mass
;;    evidence, then the top-level mission re-run with the MEASURED L/D
;;    from e30's aero-2d evidence (ld 16.05) replacing the assumed 14 ──
(eval e62 :target mockup-solid :with mass-rollup :fidelity 2
  :expect ((mass_g (<= 1500))))
(eval e63 :target sha-pek-pm :with mission-analysis :fidelity 1
  :overrides ((ld 16.05) (ff 0.28) (sfc 0.000008333) (v 95) (mtow 1200))
  :expect ((range_km (>= 1300))))
