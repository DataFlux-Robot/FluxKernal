;; examples/sha_pek.fcad —— "我想要从上海飞到北京"
;;
;; Mission: SHA(虹桥) -> PEK(首都), great-circle ≈ 1088 km.
;; Requirement: 1300 km range with 45-min reserve, 2 occupants + baggage = 180 kg,
;; MTOW 1500 kg class, electric propulsion unit (EPU) closed from the catalog.
;; Chain: Intent -> point-mass holes -> Breguet check -> param collapse ->
;; decompose -> catalog exact (EPU) -> compose back up.
;; One deliberately impossible expectation (e2x) stays as a REJECTED edge —
;; informative failures are assets, the script continues.

;; ── glossary (nouns must be operationally defined before entering specs) ──
(term aircraft "powered vehicle sustaining controlled atmosphere flight between two points")
(term range "great-circle distance flown with reserves, km")
(term payload "revenue mass carried including crew, kg")
(term mass "structural + systems mass of the object, kg")
(term thermal "heat watts rejected into the cabin air")
(term power "electrical watts drawn from the propulsion bus under load")

;; ── shared medium: cabin air absorbs rejected heat ──
(node cabin-air :role Medium :kind thermal-env
  :spec (medium (capacity (heat_w (<= 400))) (margin 0.1)))
;; ── shared medium: DC power bus feeding the fabrication cell ──
(node dc-bus :role Medium :kind dc-bus
  :spec (medium (capacity (power_w (<= 5000))) (margin 0.2)))

;; ── the demand, contract-native ──
(goal sha-pek :kind aircraft
  :spec (contract
    (goals (r1 "fly Shanghai Hongqiao to Beijing Capital nonstop with reserves"
               :falsifiable t
               :measure "mission sim: range_km vs 1088km great-circle + 45min reserve"
               :terms (range aircraft))
           (p1 "carry two occupants plus baggage" :falsifiable t
               :measure "W&B sheet at MTOW" :terms (payload)))
    (semantics aircraft range payload mass thermal power)
    (assumes (route1 "SHA-PEK great-circle corridor"
                     :bounds ((dist_km (>= 1050) (<= 1120)))))
    (guarantees (gr1 "delivers the mission with reserves"
                     :bounds ((range_km (>= 1300)) (payload_kg (>= 180)))))
    (budget (mass_kg (<= 1500)))
    (effluent (heat_w (<= 150 :medium cabin-air)))
    (forbidden (f1 "flutter below Vd/1.2" :check test)
               (f2 "CG outside envelope" :check inspection))
    (not-responsible "airport ground handling" "ATC routing")
    (time-scale mission)))

;; ── collapse step 1: point-mass model, all key params are holes ──
(refine e1 :in (sha-pek) :out sha-pek-pm :role System :kind point-mass
  :transform (point-mass-model))

;; tier-0 Breguet check with midpoint surrogate values
(eval e2 :target sha-pek-pm :with mission-analysis :fidelity 0
  :expect ((range-margin-km (> 0))))

;; collapse step 2: ground the holes to a concrete design point
;; (sfc 8.333e-6 kg/(N·s) = 0.03 kg/(N·h), typical small aero piston/turbine)
(refine e2b :in (sha-pek-pm) :out sha-pek-pm :kind point-mass
  :transform (param-perturb :values ((mtow 1200) (ff 0.28) (ld 14)
                                     (sfc 0.000008333) (v 95))))

;; concrete re-check against the actual requirement
(eval e2c :target sha-pek-pm :with mission-analysis :fidelity 0
  :expect ((range_km (>= 1300))))

;; deliberately impossible expectation: kept forever as an informative failure
(eval e2x :target sha-pek-pm :with mission-analysis :fidelity 0
  :expect ((range-margin-km (> 999999))))

;; ── decompose into subsystems; contracts flow down ──
(refine e3 :in (sha-pek-pm) :out sha-pek-v1 :role System
  :transform (decompose
    :into (wing epu fuselage avionics)
    :flow-down (
      (wing :budget ((mass_kg ("<=" 260))) :guarantees ((gw1 "wing lifts MTOW at 1.3g" :bounds ((lift_n (">=" 20000)) (mass_kg ("<=" 260))))))
      (epu :budget ((mass_kg ("<=" 320))) :guarantees ((ge1 "electric propulsion unit torque and speed" :bounds ((torque_nm (">=" 50)) (rpm (">=" 2000)) (mass_kg ("<=" 320))))))
      (fuselage :budget ((mass_kg ("<=" 380))) :guarantees ((gf1 "occupant bay and luggage" :bounds ((mass_kg ("<=" 380))))))
      (avionics :budget ((mass_kg ("<=" 40))) :guarantees ((ga1 "dual-channel navigation" :bounds ((mass_kg ("<=" 40)))))))
    ))

;; ── the EPU goal closes directly from the catalog (exact lemma) ──
(exact e4 :target sha-pek-v1/epu :from catalog
  :match "torque_nm>=50 rpm>=2000" :out epu-std)

;; ── compose back up the V right leg ──
;; ── wing STRUCTURAL decomposition: skin / spar / rib (contracts flow down) ──
(refine e4a :in (sha-pek-v1/wing) :out wing-v1 :role Component
  :transform (decompose
    :into (skin spar rib)
    :flow-down (
      (skin :budget ((mass_kg ("<=" 120))) :guarantees ((gws "skin panels carry airload" :bounds ((mass_kg ("<=" 120))))))
      (spar :budget ((mass_kg ("<=" 80))) :guarantees ((gwp "main spar carries bending" :bounds ((mass_kg ("<=" 80)) (bending_knm ("<=" 45))))))
      (rib :budget ((mass_kg ("<=" 12))) :guarantees ((gwr "rib web carries panel shear" :bounds ((mass_kg ("<=" 12)) (web_h_mm (">=" 150)))))))
    ))

;; ground the rib web: sketch (one bounded hole) -> 3mm aluminum extrusion
(refine e4b :in (wing-v1/rib) :out rib-sk :kind sketch
  :transform (ground-sketch :sketch (sketch
    (pts (p0 (param hw) 0) (p1 (param hw) 200) (p2 0 200) (p3 0 0))
    (constraints (fix p3 0 0) (dist p1 p2 600) (vert p0 p1) (horiz p1 p2))))
  :spec (contract (param-bounds (hw (>= 500) (<= 700)))))
(refine e4c :in (rib-sk) :out rib-solid :kind rib
  :transform (extrude :height 3 :material aluminum))

;; compose the wing subtree back (V right leg, one level down)
;; ══ production branch: the machined rib demands a fabrication cell ══
;; Part -> process family -> line -> machine Resource -> machine as System
;; (PRSI recursion) -> catalog closures -> fab-mill compose. The DC-bus
;; ledger gates the cell's power draw (Σ ≤ capacity×(1−margin)).
(manufacture e5a :in (rib-solid) :out rib-proc
  :transform (process-plan :into (stock milling-3axis inspection)))
(compose e5b :in (rib-proc/stock rib-proc/milling-3axis rib-proc/inspection)
  :out rib-line :role Line :kind rib-line
  :transform (line-eval)
  :rollup ((takt_min (<= 60)) (oee (>= 0.5))))
(refine e5c :in (rib-line) :out fab-req :role Resource :kind 3axis-mill-demand)
(refine e5d :in (fab-req) :out fab-v1 :role System
  :transform (decompose
    :into (bed spindle-motor cnc-drive)
    :flow-down (
      (bed :budget ((mass_kg ("<=" 2000)) (power_w ("<=" 100 ":medium" dc-bus))) :guarantees ((gfb "static stiffness" :bounds ((mass_kg ("<=" 2000))))))
      (spindle-motor :budget ((mass_kg ("<=" 9)) (power_w ("<=" 3000 ":medium" dc-bus))) :guarantees ((gfs "spindle torque and speed" :bounds ((torque_nm (">=" 8)) (rpm (">=" 12000))))))
      (cnc-drive :budget ((mass_kg ("<=" 40)) (power_w ("<=" 500 ":medium" dc-bus))) :guarantees ((gfd "drive bandwidth" :bounds ((power_w ("<=" 500)))))))
    ))

(exact e5e :target fab-v1/spindle-motor :from catalog
  :match "torque_nm>=8 rpm>=12000" :out fab-spindle-std)
(procure e5f :target fab-v1/cnc-drive :from catalog
  :match "power_w>=200 power_w<=600" :out fab-drive-bought)
(compose e5g :in (fab-v1/bed fab-spindle-std fab-drive-bought)
  :out fab-mill :role Resource :kind 3axis-mill)
;; E4: evidence density + dual termination set + printer bootstrap
;; (evolution plan v2.0: every layer carries its fidelity of evidence;
;;  structural parts converge on the shared printer capital; the printer
;;  develops itself one full round — o_i = t_(i+1) at the termination layer)
;; ══════════════════════════════════════════════════════════════════════

;; ── E4.0 the shared print capital (PRSI convergence point) ──
(term printer "unbounded-build-volume FDM capital printer")
(term frame "stiff gantry frame of a machine tool")
(node reference-printer :role Resource :kind unbounded-fdm-printer
  :spec (contract
    (goals (rp1 "print every structural part of this product tree"
                :falsifiable t
                :measure "dfam-print hard gate per printed part"
                :terms (printer frame)))
    (semantics printer frame)
    (assumes (rp-a1 "build volume effectively unbounded (demand-layer promise, not kernel-verifiable)"
                    :bounds ((dim_mm (>= 0)))))
    (guarantees (rp-g1 "prints grounded parts that pass dfam-print"
                       :bounds ((mass_g (<= 100000)))))
    (budget (mass_kg (<= 60)))
    (forbidden (rp-f1 "unattended overnight operation" :check test))
    (not-responsible "filament supply logistics")
    (time-scale fabrication)))

;; ── E4.1 per-layer simulator evidence (E2 matrix) ──
(eval e30 :target sha-pek-v1/wing :with aero-2d :fidelity 1
  :ar 14 :s_m2 3.5 :mass_kg 1200 :cruise_ms 95
  :expect ((ld_ratio (>= 14))))
(eval e31 :target epu-std :with prop-map :fidelity 1
  :torque_nm 50 :rpm 6000 :prop_d_m 0.6)
(eval e32 :target rib-solid :with beam-fe :fidelity 1 :load_n 800)

;; ── E4.2 wing structure closure: skin + spar grounded, then printed ──
(refine e34 :in (wing-v1/skin) :out skin-sk :kind sketch
  :transform (ground-sketch :sketch (sketch
    (pts (k0 0 0) (k1 3000 0) (k2 3000 1500) (k3 0 1500)) (constraints))))
(refine e35 :in (skin-sk) :out skin-solid :kind skin
  :transform (extrude :height 2 :material aluminum))
(print e36 :in (skin-solid) :printer reference-printer :out skin-printed)
(refine e37 :in (wing-v1/spar) :out spar-sk :kind sketch
  :transform (ground-sketch :sketch (sketch
    (pts (s0 0 0) (s1 3000 0) (s2 3000 200) (s3 0 200)) (constraints))))
(refine e38 :in (spar-sk) :out spar-solid :kind spar
  :transform (extrude :height 30 :material aluminum))
(print e39 :in (spar-solid) :printer reference-printer :out spar-printed)

(compose e4d :in (skin-solid spar-solid rib-solid)
  :out wing-assy :role Component :kind wing-assembly)
(compose e5 :in (wing-assy sha-pek-v1/fuselage sha-pek-v1/avionics epu-std)
  :out sha-pek-design :role System :kind light-aircraft
  :rollup ((range_km (>= 1300))))

;; ══ geometric mockup branch: ground every subsystem as 1:20 scale ══
;; Geometry is an EVALUATION PROJECTION of a node (design v0.1 §1.2): each
;; mockup part is grounded sketch -> revolve/extrude with evidence, then
;; assembled with placements + interference checking. Scale model in PLA/
;; aluminum — the FLIGHT mass budgets stay on the ungrounded design branch;
;; the mockup carries its own gram-scale hard budgets (fail-closed honesty).

(refine e6 :in (sha-pek-design) :out model-0 :kind mockup
  :transform (scale-mockup :ratio 0.05))

(refine e7 :in (model-0) :out model-v1 :role System
  :transform (decompose
    :into (m-fuselage m-wing m-hstab m-fin m-motor)
    :flow-down (
      (m-fuselage :budget ((mass_g ("<=" 500))) :guarantees ((gf1 "fusiform body of revolution" :bounds ((mass_g ("<=" 500)) (length_mm (">=" 290))))))
      (m-wing :budget ((mass_g ("<=" 300))) :guarantees ((gwm "flat-plate wing, high mounted" :bounds ((mass_g ("<=" 300)) (span_mm (">=" 500))))))
      (m-hstab :budget ((mass_g ("<=" 30))) :guarantees ((ghs "flat-plate horizontal stabilizer" :bounds ((mass_g ("<=" 30))))))
      (m-fin :budget ((mass_g ("<=" 10))) :guarantees ((gfn "vertical-plate fin, swept" :bounds ((mass_g ("<=" 10))))))
      (m-motor :budget ((mass_g ("<=" 10))) :guarantees ((gmo "motor cylinder on the nose" :bounds ((mass_g ("<=" 10)))))))
    ))

(refine e10 :in (model-v1/m-fuselage) :out m-fuselage-sk :kind sketch
  :transform (ground-sketch :sketch (sketch (pts (p0 0 0) (p1 9 30) (p2 20 75) (p3 27.5 150) (p4 27 225) (p5 19 280) (p6 11 300) (p7 0 300)) (constraints))))
(refine e11 :in (m-fuselage-sk) :out m-fuselage-solid :kind fuselage
  :transform (revolve :material pla))

(refine e12 :in (model-v1/m-wing) :out m-wing-sk :kind sketch
  :transform (ground-sketch :sketch (sketch (pts (w0 -275 0) (w1 275 0) (w2 275 60) (w3 -275 60)) (constraints))))
(refine e13 :in (m-wing-sk) :out m-wing-solid :kind wing
  :transform (extrude :height 6 :material pla))

(refine e14 :in (model-v1/m-hstab) :out m-hstab-sk :kind sketch
  :transform (ground-sketch :sketch (sketch (pts (h0 -60 0) (h1 60 0) (h2 60 30) (h3 -60 30)) (constraints))))
(refine e15 :in (m-hstab-sk) :out m-hstab-solid :kind hstab
  :transform (extrude :height 4 :material pla))

(refine e16 :in (model-v1/m-fin) :out m-fin-sk :kind sketch
  :transform (ground-sketch :sketch (sketch (pts (f0 0 275) (f1 -30 295) (f2 -30 305) (f3 0 305)) (constraints))))
(refine e17 :in (m-fin-sk) :out m-fin-solid :kind fin
  :transform (extrude :height 3 :material pla))

(refine e18 :in (model-v1/m-motor) :out m-motor-sk :kind sketch
  :transform (ground-sketch :sketch (sketch (pts (q0 0 -12) (q1 6 -12) (q2 6 0) (q3 0 0)) (constraints))))
(refine e19 :in (m-motor-sk) :out m-motor-solid :kind motor
  :transform (revolve :material aluminum))

(compose e20 :in (m-fuselage-solid m-wing-solid m-hstab-solid m-fin-solid m-motor-solid)
  :out sha-pek-model :role System :kind aircraft-mockup
  :transform (assemble :placements ((0 0 0) (0 140 30) (0 285 20) (-1.5 0 25 0 1 0 90) (0 0 0)))
  :rollup ((mass_g (<= 1500))))

;; ══════════════════════════════════════════════════════════════════════
;; ── E4.3 fuselage developed one level: cabin shell + seats; avionics
;;    closes straight from the catalog ("may split or not" — a catalog hit
;;    is a legal stopping point) ──
(refine e43 :in (sha-pek-v1/fuselage) :out fuselage-v1 :role Component
  :transform (decompose
    :into (cabin-shell seat)
    :flow-down (
      (cabin-shell :budget ((mass_kg ("<=" 200))) :guarantees ((gcs "cabin shell carries airload" :bounds ((mass_kg ("<=" 200))))))
      (seat :budget ((mass_kg ("<=" 15))) :guarantees ((gst "two occupant seats" :bounds ((mass_kg ("<=" 15)))))))))
(refine e47 :in (fuselage-v1/cabin-shell) :out cabin-sk :kind sketch
  :transform (ground-sketch :sketch (sketch
    (pts (c0 0 0) (c1 800 0) (c2 800 1400) (c3 0 1400)) (constraints))))
(refine e48 :in (cabin-sk) :out cabin-solid :kind cabin-shell
  :transform (extrude :height 3 :material aluminum))
(print e49 :in (cabin-solid) :printer reference-printer :out cabin-printed)
(exact e45 :target fuselage-v1/seat :from catalog
  :match "mass_kg<=15" :out seat-std)
(exact e46 :target sha-pek-v1/avionics :from catalog
  :match "mass_kg<=40" :out av-std)

;; ── E4.4 the mill's bed: grounded as a structural part and PRINTED by the
;;    shared printer — generation 0 prints generation 1's machine tool
;;    (printer -> bed link in the DAG), while spindle/drive stay catalog ──
(refine e40 :in (fab-v1/bed) :out bed-sk :kind sketch
  :transform (ground-sketch :sketch (sketch
    (pts (b0 -400 -300) (b1 400 -300) (b2 400 300) (b3 -400 300)) (constraints))))
(refine e41 :in (bed-sk) :out bed-solid :kind bed
  :transform (extrude :height 60 :material aluminum))
(print e42 :in (bed-solid) :printer reference-printer :out bed-printed)

;; ── E4.5 the printer develops ITSELF one full round (E1-3 hard rule):
;;    frame printed on itself (bootstrap), stepper/board from catalog ──
(refine e50 :in (reference-printer) :out printer-v1 :role System
  :transform (decompose
    :into (p-frame p-stepper p-board)
    :flow-down (
      (p-frame :budget ((mass_g ("<=" 6000))) :guarantees ((gpf "stiff gantry frame" :bounds ((mass_g ("<=" 6000))))))
      (p-stepper :budget ((mass_g ("<=" 400))) :guarantees ((gps "extruder stepper torque" :bounds ((torque_nm (">=" 0.35))))))
      (p-board :budget ((mass_g ("<=" 300))) :guarantees ((gpb "4-axis motion board" :bounds ((axis_count (">=" 4)))))))))
(refine e51 :in (printer-v1/p-frame) :out pframe-sk :kind sketch
  :transform (ground-sketch :sketch (sketch
    (pts (r0 0 0) (r1 600 0) (r2 600 600) (r3 0 600)) (constraints))))
(refine e52 :in (pframe-sk) :out pframe-solid :kind frame
  :transform (extrude :height 8 :material pla))
(print e53 :in (pframe-solid) :printer reference-printer :out pframe-printed)
(exact e54 :target printer-v1/p-stepper :from catalog
  :match "torque_nm>=0.35" :out p-stepper-std)
(procure e55 :target printer-v1/p-board :from catalog
  :match "axis_count>=4" :out p-board-bought)

;; ── E4.6 mockup parts terminate on the printer too (PLA, 1:20) ──
(print e56 :in (m-fuselage-solid) :printer reference-printer :out mp-fuselage)
(print e57 :in (m-wing-solid) :printer reference-printer :out mp-wing)
(print e58 :in (m-hstab-solid) :printer reference-printer :out mp-hstab)
(print e59 :in (m-fin-solid) :printer reference-printer :out mp-fin)
(print e60 :in (m-motor-solid) :printer reference-printer :out mp-motor)

;; ── E4.7 closed-loop re-verification (V-model right leg): assembly mass
;;    evidence, then the top-level mission re-run with the MEASURED L/D
;;    from e30's aero-2d evidence (ld 16.05) replacing the assumed 14 ──
(eval e62 :target sha-pek-model :with mass-rollup :fidelity 2
  :expect ((mass_g (<= 1500))))
(eval e63 :target sha-pek-pm :with mission-analysis :fidelity 1
  :overrides ((ld 16.05) (ff 0.28) (sfc 0.000008333) (v 95) (mtow 1200))
  :expect ((range_km (>= 1300))))
