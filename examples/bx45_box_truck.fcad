;; ═══════════════════════════════════════════════════════════════════
;; BX-45: light cab-over box truck, reverse-engineered from a photo via
;; the fcad-from-image six-station pipeline.
;;   ① VLM parse: cab-over cab at the very front, enclosed box directly
;;      behind and TALLER than the cab, 4x2 running gear
;;   ② web: comparable class chassis 5400x1840 (wheelbase 3000, Ollin)
;;      and box 4180x2300x2200 (Kangling J6)
;;   ③ every image/web number carries :tier and lives in assumes ONLY —
;;      guarantees cite the mission, never the photo
;;   ④ mechanisms: cabin-fuselage x2 (cab + straight box), printed
;;      rails, catalog running gear
;; ═══════════════════════════════════════════════════════════════════

;; ── case contract: reverse-engineered box truck ──
(case-contract bx45 :type product-reverse
  :requires (
    (termination (standard-parts printable))
    (manufacturing-chains 1)))

;; ── glossary ──
(term range "distance flown between charges with reserve, km")
(term mass "curb + payload mass of the vehicle, kg")
(term payload "cargo mass carried, kg")
(term power "electrical watts drawn from the bus under load")
(term printer "additive fabrication resource")
(term frame "structural frame of a machine")

;; ── media ──
(node dc-bus :role Medium :kind dc-bus
  :spec (medium (capacity (power_w (<= 6000))) (margin 0.2)))

(node reference-printer :role Resource :kind unbounded-fdm-printer
  :spec (contract
    (goals (rp1 "print every structural part of this product tree"
                :falsifiable t
                :measure "dfam-print hard gate per printed part"
                :terms (printer frame)))
    (semantics printer frame)
    (assumes (rp-a1 "build volume effectively unbounded (demand-layer promise)"
                    :bounds ((dim_mm (>= 0)))))
    (guarantees (rp-g1 "prints grounded parts that pass dfam-print"
                       :bounds ((mass_g (<= 100000)))))
    (budget (mass_kg (<= 60)))
    (forbidden (rp-f1 "unattended overnight operation" :check test))
    (not-responsible "filament supply logistics")
    (time-scale fabrication)))

;; ── single-source parameters (④: from ①+②, not literals) ──
(params bx ((overall-len 5200) (cab-len 1250) (cab-w 1900) (cab-h 2250)
            (box-len 3600) (box-w 2050) (box-h 2450)
            (wheelbase 3000) (rail-h 100)))

;; ── the demand, contract-native ──
(goal bx45 :kind truck
  :spec (contract
    (goals (r1 "urban distribution runs of 200 km per shift with reserve"
               :falsifiable t
               :measure "mission sim: range_km vs duty cycle + reserve"
               :terms (range mass))
           (p1 "haul the rated box cargo over the full mission"
               :falsifiable t :measure "payload manifest at GVW"
               :terms (payload)))
    (semantics range mass payload power)
    (assumes (img1 "overall length 4500-5500mm from photo proportions"
                   :bounds ((length_mm (>= 4500) (<= 5500)))
                   :tier image-inferred)
             (web1 "comparable class chassis 5400x1840, wheelbase 3000"
                   :bounds ((length_mm (>= 5000) (<= 6000))
                            (width_mm (>= 1700) (<= 2100)))
                   :tier web-sourced)
             (web2 "class box 4180x2300x2200 (Kangling J6)"
                   :bounds ((box_len_mm (>= 3500) (<= 4300))
                            (box_h_mm (>= 2000) (<= 2400)))
                   :tier web-sourced)
             (route1 "urban corridor"
                     :bounds ((dist_km (>= 180) (<= 240)))))
    (guarantees (gr1 "delivers the box cargo with reserves"
                     :bounds ((range_km (>= 150)) (payload_kg (>= 1500)))))
    (budget (mass_kg (<= 4495)))
    (effluent (heat_w (<= 200 :medium dc-bus)))
    (forbidden (f1 "frame resonance below 8 Hz" :check test)
               (f2 "box door seal failure at GVW" :check inspection))
    (not-responsible "driver licensing" "cold-chain refrigeration")
    (time-scale mission)))

;; ── mission model ──
(refine e1 :in (bx45) :out bx-pm :role System :kind point-mass
  :transform (point-mass-model))
(eval e2 :target bx-pm :with mission-analysis :fidelity 0
  :expect ((range-margin-km (> 0))))
;; L/D 6.5 assumes a cab roof fairing closing the cab/box step (design
;; intent carried by the cab tail-frac 0.85); cruise 90 km/h
(refine e2b :in (bx-pm) :out bx-pm :kind point-mass
  :transform (param-perturb :values ((mtow 4495) (ff 0.08) (ld 6.5)
                                     (sfc 0.000008333) (v 25))))
(eval e2c :target bx-pm :with mission-analysis :fidelity 0
  :expect ((range_km (>= 150))))
(eval e2x :target bx-pm :with mission-analysis :fidelity 0
  :expect ((range-margin-km (> 999999))) :informative t)

;; ── decompose; budgets flow down (Σ=1500 ≤ 4495) ──
(refine e3 :in (bx-pm) :out bx-v1 :role System
  :transform (decompose
    :into (cab cargo-box frame-l frame-r axle-f axle-r
               wheel-fl wheel-fr wheel-rl wheel-rr powertrain seat)
    :flow-down (
      (cab :budget ((mass_kg ("<=" 160))) :guarantees ((gc "cab shell protects" :bounds ((mass_kg ("<=" 160))))))
      (cargo-box :budget ((mass_kg ("<=" 290))) :guarantees ((gb "box carries" :bounds ((mass_kg ("<=" 260))))))
      (frame-l :budget ((mass_kg ("<=" 90))) :guarantees ((gfl "left rail" :bounds ((mass_kg ("<=" 90))))))
      (frame-r :budget ((mass_kg ("<=" 90))) :guarantees ((gfr "right rail" :bounds ((mass_kg ("<=" 90))))))
      (axle-f :budget ((mass_kg ("<=" 95))) :guarantees ((gaf "front axle" :bounds ((mass_kg ("<=" 95))))))
      (axle-r :budget ((mass_kg ("<=" 95))) :guarantees ((gar "rear axle" :bounds ((mass_kg ("<=" 95))))))
      (wheel-fl :budget ((mass_kg ("<=" 50))) :guarantees ((gw1 "front left wheel" :bounds ((mass_kg ("<=" 50))))))
      (wheel-fr :budget ((mass_kg ("<=" 50))) :guarantees ((gw2 "front right wheel" :bounds ((mass_kg ("<=" 50))))))
      (wheel-rl :budget ((mass_kg ("<=" 50))) :guarantees ((gw3 "rear left wheel" :bounds ((mass_kg ("<=" 50))))))
      (wheel-rr :budget ((mass_kg ("<=" 50))) :guarantees ((gw4 "rear right wheel" :bounds ((mass_kg ("<=" 50))))))
      (powertrain :budget ((mass_kg ("<=" 15))) :guarantees ((gpt "drive motor" :bounds ((mass_kg ("<=" 15))))))
      (seat :budget ((mass_kg ("<=" 20))) :guarantees ((gst "driver seat" :bounds ((mass_kg ("<=" 20)))))))))

;; ── cab: cab-over, at the very front (①: no hood in the photo) ──
(instantiate e4 :at (bx-v1/cab) :mechanism cabin-fuselage
  :params ((length (:param bx/cab-len)) (width (:param bx/cab-w))
           (height (:param bx/cab-h)) (tail-frac 0.85)
           (section rect)
           (x0 0) (y0 0) (z0 -150))
  :printer reference-printer :out cab)

;; ── box: straight walls, directly behind the cab and taller (①) ──
(instantiate e5 :at (bx-v1/cargo-box) :mechanism cabin-fuselage
  :params ((length (:param bx/box-len)) (width (:param bx/box-w))
           (height (:param bx/box-h)) (tail-frac 1.0)
           (section rect)
           (x0 0) (y0 1300) (z0 -150))
  :printer reference-printer :out box)

;; ── ladder frame ──
(refine e6 :in (bx-v1/frame-l) :out frame-l-sk :kind sketch
  :transform (ground-sketch :sketch (sketch
    (pts (a0 0 0) (a1 120 0) (a2 120 5000) (a3 0 5000)) (constraints))))
(refine e7 :in (frame-l-sk) :out frame-l-solid :role Part :kind frame
  :transform (extrude :height (:param bx/rail-h) :material pla
                      :at ((-920 0 0))))
(refine e7f :in (frame-l-solid) :out frame-l-fil :role Part :kind frame
  :transform (fillet :edges all :radius 0.6))
(print e8 :in (frame-l-fil) :printer reference-printer :out frame-l-printed)
(refine e9 :in (bx-v1/frame-r) :out frame-r-sk :kind sketch
  :transform (ground-sketch :sketch (sketch
    (pts (b0 0 0) (b1 120 0) (b2 120 5000) (b3 0 5000)) (constraints))))
(refine e10 :in (frame-r-sk) :out frame-r-solid :role Part :kind frame
  :transform (extrude :height (:param bx/rail-h) :material pla
                      :at ((800 0 0))))
(refine e10f :in (frame-r-solid) :out frame-r-fil :role Part :kind frame
  :transform (fillet :edges all :radius 0.6))
(print e11 :in (frame-r-fil) :printer reference-printer :out frame-r-printed)

;; ── 4x2 running gear (①: two axles) ──
(exact e12 :target bx-v1/axle-f :from catalog
  :match "mass_kg<=95 length_mm>=1500" :out axle-f-std
  :at ((-850 1150 -280)))
(exact e13 :target bx-v1/axle-r :from catalog
  :match "mass_kg<=95 length_mm>=1500" :out axle-r-std
  :at ((-850 4150 -280)))
(exact e14 :target bx-v1/wheel-fl :from catalog
  :match "mass_kg<=50 dia_mm=750" :out wheel-fl-std :at ((-1600 775 -655)))
(exact e15 :target bx-v1/wheel-fr :from catalog
  :match "mass_kg<=50 dia_mm=750" :out wheel-fr-std :at ((850 775 -655)))
(exact e16 :target bx-v1/wheel-rl :from catalog
  :match "mass_kg<=50 dia_mm=750" :out wheel-rl-std :at ((-1600 3775 -655)))
(exact e17 :target bx-v1/wheel-rr :from catalog
  :match "mass_kg<=50 dia_mm=750" :out wheel-rr-std :at ((850 3775 -655)))

;; ── powertrain + interior ──
(exact e18 :target bx-v1/powertrain :from catalog
  :match "torque_nm>=8 power_w>=1500" :out motor-std
  :at ((0 3900 250)))
(exact e19 :target bx-v1/seat :from catalog
  :match "mass_kg<=15" :out seat-std :at ((0 600 450)))

;; ── T4: the cargo box shell decomposes into wall panels — the box is
;;    not a monolithic leaf; each panel carries its own flow-down budget
;;    (mechanism bulkhead pattern applied to walls) ──
(refine e50 :in (box/shell) :out box-panels :role Part
  :transform (decompose
    :into (wall-l wall-r roof floor)
    :roles ((wall-l Part) (wall-r Part) (roof Part) (floor Part))
    :flow-down (
      (wall-l :budget ((mass_kg ("<=" 50))) :guarantees ((gwl "left wall" :bounds ((mass_kg ("<=" 50))))))
      (wall-r :budget ((mass_kg ("<=" 50))) :guarantees ((gwr "right wall" :bounds ((mass_kg ("<=" 50))))))
      (roof :budget ((mass_kg ("<=" 45))) :guarantees ((grf "box roof" :bounds ((mass_kg ("<=" 45))))))
      (floor :budget ((mass_kg ("<=" 38))) :guarantees ((gfl2 "box floor" :bounds ((mass_kg ("<=" 38)))))))))
(refine e50l :in (box-panels/wall-l) :out wlp-sk :kind sketch
  :transform (ground-sketch :sketch (sketch
    (pts (w0 0 0) (w1 3600 0) (w2 3600 2450) (w3 0 2450)) (constraints))))
(refine e50l2 :in (wlp-sk) :out wlp-solid :role Part :kind panel
  :transform (extrude :height 4 :material pla :at ((-1025 1300 280))))
(refine e50l3 :in (wlp-solid) :out wlp-fil :role Part :kind panel
  :transform (fillet :edges all :radius 0.6))
(print e50l4 :in (wlp-fil) :printer reference-printer :out wlp-printed)

(refine e50r :in (box-panels/wall-r) :out wrp-sk :kind sketch
  :transform (ground-sketch :sketch (sketch
    (pts (r0 0 0) (r1 3600 0) (r2 3600 2450) (r3 0 2450)) (constraints))))
(refine e50r2 :in (wrp-sk) :out wrp-solid :role Part :kind panel
  :transform (extrude :height 4 :material pla :at ((1021 1300 280))))
(refine e50r3 :in (wrp-solid) :out wrp-fil :role Part :kind panel
  :transform (fillet :edges all :radius 0.6))
(print e50r4 :in (wrp-fil) :printer reference-printer :out wrp-printed)
(refine e50rf :in (box-panels/roof) :out rf-sk :kind sketch
  :transform (ground-sketch :sketch (sketch
    (pts (v0 0 0) (v1 3600 0) (v2 3600 2050) (v3 0 2050)) (constraints))))
(refine e50rf2 :in (rf-sk) :out rf-solid :role Part :kind panel
  :transform (extrude :height 4 :material pla
    :at ((-1025 1300 2734) (1 0 0 90))))
(refine e50rf3 :in (rf-solid) :out rf-fil :role Part :kind panel
  :transform (fillet :edges all :radius 0.6))
(print e50rf4 :in (rf-fil) :printer reference-printer :out rf-printed)
(refine e50fl :in (box-panels/floor) :out fl-sk :kind sketch
  :transform (ground-sketch :sketch (sketch
    (pts (u0 0 0) (u1 3600 0) (u2 3600 2050) (u3 0 2050)) (constraints))))
(refine e50fl2 :in (fl-sk) :out fl-solid :role Part :kind panel
  :transform (extrude :height 4 :material pla :at ((-1025 1300 -100))))
(refine e50fl3 :in (fl-solid) :out fl-fil :role Part :kind panel
  :transform (fillet :edges all :radius 0.6))
(print e50fl4 :in (fl-fil) :printer reference-printer :out fl-printed)

;; ── T5: one machined part closes the manufacturing-chain require —
;;    the frame cross-member is milled on the developed gantry mill
;;    (same DSL pattern as the SHA-PEK rib branch) ──
(refine e60 :in (bx-v1/frame-l) :out xmb-sk :kind sketch
  :transform (ground-sketch :sketch (sketch
    (pts (x0 0 0) (x1 120 0) (x2 120 220) (x3 0 220)) (constraints))))
(refine e61 :in (xmb-sk) :out xmb-solid :role Part :kind cross-member
  :transform (extrude :height 10 :material aluminum :at ((-920 2900 100))))
(refine e61f :in (xmb-solid) :out xmb-fil :role Part :kind cross-member
  :transform (fillet :edges all :radius 0.6))
;; the machine tool demand + development (gantry archetype)
(refine e62 :in (bx-v1) :out mill-req :role Resource :kind gantry-mill-demand
  :spec (contract (budget (mass_kg (<= 1000)))))
(refine e63 :in (mill-req) :out mill-v1 :role System
  :transform (decompose :template gantry-mill))
(refine e64 :in (mill-v1/bed) :out mbed-sk :kind sketch
  :transform (ground-sketch :sketch (sketch
    (pts (m0 0 0) (m1 1800 0) (m2 1800 800) (m3 0 800)) (constraints))))
(refine e65 :in (mbed-sk) :out mbed-solid :role Part :kind bed
  :transform (extrude :height 60 :material pla :at ((-6000 3000 0))))
(refine e65f :in (mbed-solid) :out mbed-fil :role Part :kind bed
  :transform (fillet :edges all :radius 0.6))
(print e66 :in (mbed-fil) :printer reference-printer :out mbed-printed)
(refine e64c :in (mill-v1/column-L) :out mcolL-sk :kind sketch
  :transform (ground-sketch :sketch (sketch
    (pts (c0 0 0) (c1 300 0) (c2 300 300) (c3 0 300)) (constraints))))
(refine e65c :in (mcolL-sk) :out mcolL-solid :role Part :kind column
  :transform (extrude :height 1200 :material pla :at ((-5800 3000 60))))
(refine e65cf :in (mcolL-solid) :out mcolL-fil :role Part :kind column
  :transform (fillet :edges all :radius 0.6))
(print e66c :in (mcolL-fil) :printer reference-printer :out mcolL-printed)
(refine e64d :in (mill-v1/column-R) :out mcolR-sk :kind sketch
  :transform (ground-sketch :sketch (sketch
    (pts (d0 0 0) (d1 300 0) (d2 300 300) (d3 0 300)) (constraints))))
(refine e65d :in (mcolR-sk) :out mcolR-solid :role Part :kind column
  :transform (extrude :height 1200 :material pla :at ((-4600 3000 60))))
(refine e65df :in (mcolR-solid) :out mcolR-fil :role Part :kind column
  :transform (fillet :edges all :radius 0.6))
(print e66d :in (mcolR-fil) :printer reference-printer :out mcolR-printed)
(refine e64e :in (mill-v1/crossbeam) :out mbeam-sk :kind sketch
  :transform (ground-sketch :sketch (sketch
    (pts (e0 0 0) (e1 1500 0) (e2 1500 120) (e3 0 120)) (constraints))))
(refine e65e :in (mbeam-sk) :out mbeam-solid :role Part :kind crossbeam
  :transform (extrude :height 60 :material pla :at ((-5800 3440 1260))))
(refine e65ef :in (mbeam-solid) :out mbeam-fil :role Part :kind crossbeam
  :transform (fillet :edges all :radius 0.6))
(print e66e :in (mbeam-fil) :printer reference-printer :out mbeam-printed)
(refine e64h :in (mill-v1/z-head) :out mhead-sk :kind sketch
  :transform (ground-sketch :sketch (sketch
    (pts (h0 0 0) (h1 200 0) (h2 200 200) (h3 0 200)) (constraints))))
(refine e65h :in (mhead-sk) :out mhead-solid :role Part :kind spindle-head
  :transform (extrude :height 150 :material pla :at ((-4700 3390 1320))))
(refine e65hf :in (mhead-solid) :out mhead-fil :role Part :kind spindle-head
  :transform (fillet :edges all :radius 0.6))
(print e66h :in (mhead-fil) :printer reference-printer :out mhead-printed)

(exact e67 :target mill-v1/spindle :from catalog
  :match "torque_nm>=8 rpm>=12000" :out mill-spindle
  :at ((-5200 3400 500)))
(procure e68 :target mill-v1/cnc :from catalog
  :match "axis_count>=4" :out mill-cnc :at ((-5400 3200 300)))
;; axis modules: catalog rails/screws/servos + printed carriage
(refine e64x :in (mill-v1/x-axis) :out xax2 :role Component
  :transform (decompose
    :into (x-rail x-screw x-servo x-carriage)
    :roles ((x-rail Part) (x-screw Part) (x-servo Part) (x-carriage Part))
    :flow-down (
      (x-rail :budget ((mass_kg ("<=" 6))) :guarantees ((gx2 "X rail" :bounds ((mass_kg ("<=" 6))))))
      (x-screw :budget ((mass_kg ("<=" 0.1))) :guarantees ((gxs2 "X screw" :bounds ((mass_kg ("<=" 0.1))))))
      (x-servo :budget ((mass_kg ("<=" 2.5))) :guarantees ((gxv2 "X servo" :bounds ((mass_kg ("<=" 2.5))))))
      (x-carriage :budget ((mass_kg ("<=" 3))) :guarantees ((gxc2 "X carriage" :bounds ((mass_kg ("<=" 3)))))))))
(exact e65x :target xax2/x-rail :from catalog :match "travel_mm>=1700"
  :out xrail-std :at ((-5900 3050 70)))
(procure e65xs :target xax2/x-screw :from catalog :match "dia_mm=8"
  :out xscrew-bought :at ((-5900 2980 40)))
(exact e65xv :target xax2/x-servo :from catalog
  :match "torque_nm>=0.35 mass_g<=2500" :out xservo-std
  :at ((-5950 2900 40)))
(refine e65xc :in (xax2/x-carriage) :out xcar2-sk :kind sketch
  :transform (ground-sketch :sketch (sketch
    (pts (q0 0 0) (q1 150 0) (q2 150 120) (q3 0 120)) (constraints))))
(refine e65xc2 :in (xcar2-sk) :out xcar2-solid :role Part :kind carriage
  :transform (extrude :height 80 :material pla :at ((-5600 3060 70))))
(refine e65xc3 :in (xcar2-solid) :out xcar2-fil :role Part :kind carriage
  :transform (fillet :edges all :radius 0.6))
(print e65xc4 :in (xcar2-fil) :printer reference-printer
  :out xcar2-printed)
(compose e66x :in (xrail-std xscrew-bought xservo-std xcar2-printed)
  :out xax2-assy :role Component :kind axis-module)

(refine e64y :in (mill-v1/y-axis) :out yax2 :role Component
  :transform (decompose
    :into (y-rail y-screw y-servo y-carriage)
    :roles ((y-rail Part) (y-screw Part) (y-servo Part) (y-carriage Part))
    :flow-down (
      (y-rail :budget ((mass_kg ("<=" 6))) :guarantees ((gy2 "Y rail" :bounds ((mass_kg ("<=" 6))))))
      (y-screw :budget ((mass_kg ("<=" 0.1))) :guarantees ((gys2 "Y screw" :bounds ((mass_kg ("<=" 0.1))))))
      (y-servo :budget ((mass_kg ("<=" 2.5))) :guarantees ((gyv2 "Y servo" :bounds ((mass_kg ("<=" 2.5))))))
      (y-carriage :budget ((mass_kg ("<=" 3))) :guarantees ((gyc2 "Y carriage" :bounds ((mass_kg ("<=" 3)))))))))
(exact e65y :target yax2/y-rail :from catalog :match "travel_mm>=700"
  :out yrail-std :at ((-5300 3000 70) (0 0 1 90)))
(procure e65ys :target yax2/y-screw :from catalog :match "dia_mm=8"
  :out yscrew-bought :at ((-5370 3050 40) (0 0 1 90)))
(exact e65yv :target yax2/y-servo :from catalog
  :match "torque_nm>=0.35 mass_g<=2500" :out yservo-std
  :at ((-5450 3050 40) (0 0 1 90)))
(refine e65yc :in (yax2/y-carriage) :out ycar2-sk :kind sketch
  :transform (ground-sketch :sketch (sketch
    (pts (s0 0 0) (s1 150 0) (s2 150 120) (s3 0 120)) (constraints))))
(refine e65yc2 :in (ycar2-sk) :out ycar2-solid :role Part :kind carriage
  :transform (extrude :height 80 :material pla :at ((-5300 3500 70))))
(refine e65yc3 :in (ycar2-solid) :out ycar2-fil :role Part :kind carriage
  :transform (fillet :edges all :radius 0.6))
(print e65yc4 :in (ycar2-fil) :printer reference-printer
  :out ycar2-printed)
(compose e66y :in (yrail-std yscrew-bought yservo-std ycar2-printed)
  :out yax2-assy :role Component :kind axis-module)

(refine e64z :in (mill-v1/z-axis) :out zax2 :role Component
  :transform (decompose
    :into (z-rail z-screw z-servo z-carriage)
    :roles ((z-rail Part) (z-screw Part) (z-servo Part) (z-carriage Part))
    :flow-down (
      (z-rail :budget ((mass_kg ("<=" 6))) :guarantees ((gz2 "Z rail" :bounds ((mass_kg ("<=" 6))))))
      (z-screw :budget ((mass_kg ("<=" 0.1))) :guarantees ((gzs2 "Z screw" :bounds ((mass_kg ("<=" 0.1))))))
      (z-servo :budget ((mass_kg ("<=" 2.5))) :guarantees ((gzv2 "Z servo" :bounds ((mass_kg ("<=" 2.5))))))
      (z-carriage :budget ((mass_kg ("<=" 3))) :guarantees ((gzc2 "Z carriage" :bounds ((mass_kg ("<=" 3)))))))))
(exact e65z :target zax2/z-rail :from catalog :match "travel_mm>=400"
  :out zrail-std :at ((-4650 3390 500) (0 1 0 90)))
(procure e65zs :target zax2/z-screw :from catalog :match "dia_mm=8"
  :out zscrew-bought :at ((-4710 3390 500) (0 1 0 90)))
(exact e65zv :target zax2/z-servo :from catalog
  :match "torque_nm>=0.35 mass_g<=2500" :out zservo-std
  :at ((-4770 3390 1400) (0 1 0 90)))
(refine e65zc :in (zax2/z-carriage) :out zcar2-sk :kind sketch
  :transform (ground-sketch :sketch (sketch
    (pts (t0 0 0) (t1 150 0) (t2 150 120) (t3 0 120)) (constraints))))
(refine e65zc2 :in (zcar2-sk) :out zcar2-solid :role Part :kind carriage
  :transform (extrude :height 80 :material pla :at ((-4700 3450 1320))))
(refine e65zc3 :in (zcar2-solid) :out zcar2-fil :role Part :kind carriage
  :transform (fillet :edges all :radius 0.6))
(print e65zc4 :in (zcar2-fil) :printer reference-printer
  :out zcar2-printed)
(compose e66z :in (zrail-std zscrew-bought zservo-std zcar2-printed)
  :out zax2-assy :role Component :kind axis-module)

(compose e69 :in (mbed-printed mcolL-printed mcolR-printed
                 mbeam-printed mhead-printed
                 xax2-assy yax2-assy zax2-assy mill-spindle mill-cnc)
  :out fab-mill2 :role Resource :kind gantry-mill)
;; the machining chain: cross-member milled ON the developed mill
(manufacture e70 :in (xmb-fil) :out xmb-proc :machine fab-mill2
  :transform (process-plan :into (stock milling-3axis inspection)))
(compose e71 :in (xmb-proc/stock xmb-proc/milling-3axis xmb-proc/inspection)
  :out xmb-line :role Line :kind cross-member-line
  :transform (line-eval))

;; ── assemblies + the vehicle ──
(compose e20 :in (frame-l-printed frame-r-printed axle-f-std axle-r-std
                 wheel-fl-std wheel-fr-std wheel-rl-std wheel-rr-std)
  :out chassis-assy :role Component :kind chassis)
;; the machining line SUPPORTS production — it is not a vehicle part
;; (System -> Line is not a legal transition; the line stays its own
;; closed branch, same as SHA-PEK's rib-line)
(compose e21 :in (cab/assembly box/assembly chassis-assy
                 motor-std seat-std)
  :out bx-design :role System :kind truck)

;; ══ printer bootstrap ══
(refine e30 :in (reference-printer) :out printer-v1 :role System
  :transform (decompose
    :into (p-frame p-stepper p-board)
    :flow-down (
      (p-frame :budget ((mass_g ("<=" 9000))) :guarantees ((gpf "stiff gantry frame" :bounds ((mass_g ("<=" 9000))))))
      (p-stepper :budget ((mass_g ("<=" 400))) :guarantees ((gps "extruder stepper torque" :bounds ((torque_nm (">=" 0.35))))))
      (p-board :budget ((mass_g ("<=" 300))) :guarantees ((gpb "4-axis motion board" :bounds ((axis_count (">=" 4)))))))))
(refine e31 :in (printer-v1/p-frame) :out pframe-sk :kind sketch
  :transform (ground-sketch :sketch (sketch
    (pts (r0 0 0) (r1 600 0) (r2 600 600) (r3 0 600)) (constraints))))
(refine e32 :in (pframe-sk) :out pframe-solid :kind frame
  :transform (extrude :height 8 :material pla :at ((-3000 3000 0))))
(refine e32f :in (pframe-solid) :out pframe-fil :kind frame
  :transform (fillet :edges all :radius 0.6))
(print e33 :in (pframe-fil) :printer reference-printer :out pframe-printed)
(exact e34 :target printer-v1/p-stepper :from catalog
  :match "torque_nm>=0.35 mass_g<=400" :out p-stepper-std
  :at ((-3060 3600 608)))
(procure e35 :target printer-v1/p-board :from catalog
  :match "axis_count>=4" :out p-board-bought
  :at ((-2940 3300 606)))
(compose e36 :in (pframe-printed p-stepper-std p-board-bought)
  :out printer-assy :role Resource :kind fdm-printer)

;; ══ closed-loop re-verification ══
(eval e40 :target cab/assembly :with mass-rollup :fidelity 2
  :expect ((mass_kg (<= 160))))
(eval e41 :target box/assembly :with mass-rollup :fidelity 2
  :expect ((mass_kg (<= 290))))
(eval e42 :target chassis-assy :with mass-rollup :fidelity 2
  :expect ((mass_kg (<= 480))))
(eval e43 :target bx-pm :with mission-analysis :fidelity 1
  :overrides ((ld 6.5) (ff 0.08) (sfc 0.000008333) (v 25) (mtow 4495))
  :expect ((range_km (>= 150))))
