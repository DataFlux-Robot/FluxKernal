{
 "id": "wingbox",
 "version": "3.0.0",
 "_doc": "Airfoil-section wing: one NACA-4 skin (tc, camber params) lofted root->tip and shelled to the wall thickness; spar webs with chamfered caps inside; airfoil-inset ribs; rib-1 reserved for machining, the rest printed.",
 "params": {
  "span": {
   "type": "length_mm",
   "range": [
    500,
    20000
   ]
  },
  "chord": {
   "type": "length_mm",
   "range": [
    200,
    5000
   ]
  },
  "height": {
   "type": "length_mm",
   "range": [
    50,
    1000
   ]
  },
  "tc": {
   "type": "ratio",
   "range": [
    0.06,
    0.24
   ],
   "default-expr": 0.12
  },
  "camber": {
   "type": "ratio",
   "range": [
    0.0,
    0.06
   ],
   "default-expr": 0.02
  },
  "rib-count": {
   "default-expr": [
    "ceil",
    [
     "/",
     "span",
     500
    ]
   ]
  }
 },
 "module": "fluxkernel.mechanisms.wingbox",
 "policies": [
  "rib-spacing",
  "print-fillet"
 ],
 "termination": {
  "print": [
   "skin",
   "spar-front",
   "spar-rear",
   "rib-2",
   "rib-3",
   "rib-4",
   "rib-5",
   "rib-6",
   "rib-7",
   "rib-8"
  ],
  "reserve": [
   "rib-1"
  ]
 },
 "solvers": [
  "beam/plate",
  "aero-2d",
  "mate/ocp"
 ],
 "features_provided": [
  "airfoil-section",
  "hollow-skin",
  "spar-row",
  "rib-row"
 ]
}