<!-- Description for "Cookie", a third-generation Upkie wheeled biped -->
<!-- Conventions: https://github.com/upkie/upkie_description/wiki/Model-conventions -->
<robot name="cookie">
  <material name="black">
    <color rgba="0.1 0.1 0.1 1"/>
  </material>
  <material name="dark_blue">
    <color rgba="0.0 0.1 0.2 1"/>
  </material>
  <material name="metallic_gray">
    <color rgba="0.55 0.57 0.58 1"/>
  </material>
  <material name="lipstick_green">
    <color rgba="0.20 0.92 0.27 1"/>
  </material>
  <material name="lipstick_red">
    <color rgba="0.92 0.20 0.27 1"/>
  </material>
  <material name="mango_yellow">
    <color rgba="0.97 0.73 0.0 1"/>
  </material>
  <material name="mj5208_rotor">
    <color rgba="0.5 0.55 0.6 1.0"/>
  </material>
  <material name="mj5208_stator">
    <color rgba="0.22 0.22 0.25 1.0"/>
  </material>
  <!-- Virtual link for the base -->
  <link name="base">
    <!-- virtual link: https://upkie.github.io/upkie/kinematics.html#virtual-links -->
    <visual>
      <geometry>
        <box size="0 0 0"/>
      </geometry>
    </visual>
    <inertial>
      <mass value="0.001"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
  </link>
  <!-- Torso comes first -->
  <link name="torso">
    <visual>
      <geometry>
        <mesh filename="package://cookie_description/meshes/torso.stl"/>
      </geometry>
      <material name="mango_yellow"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0.005 0.08"/>
      <geometry>
        <box size="0.02 0.143 0.0105"/>
      </geometry>
    </collision>
    <collision>
      <origin rpy="0.77 0 0" xyz="0 -0.092 0.054"/>
      <geometry>
        <box size="0.02 0.08 0.0105"/>
      </geometry>
    </collision>
    <collision>
      <origin rpy="-0.77 0 0" xyz="0 0.102 0.054"/>
      <geometry>
        <box size="0.02 0.08 0.0105"/>
      </geometry>
    </collision>
    <collision>
      <origin rpy="0 0 0" xyz="0.001 0.005 -0.025"/>
      <geometry>
        <box size="0.14 0.171 0.15"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0.001 0.005 -0.025"/>
      <mass value="1.739"/>
      <inertia ixx="0.0074981332500000004" ixy="0" ixz="0" iyy="0.006100991666666666" iyz="0" izz="0.007077874916666668"/>
    </inertial>
  </link>
  <joint name="torso_placement" type="fixed">
    <parent link="base"/>
    <child link="torso"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>
  <!-- Battery indicator -->
  <link name="battery_indicator">
    <visual>
      <geometry>
        <box size="0.0025 0.039 0.02"/>
      </geometry>
      <material name="dark_blue"/>
    </visual>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.001"/>
      <inertia ixx="1.6008333333333333e-07" ixy="0" ixz="0" iyy="3.385416666666667e-08" iyz="0" izz="1.2727083333333333e-07"/>
    </inertial>
  </link>
  <joint name="battery_indicator_placement" type="fixed">
    <parent link="base"/>
    <child link="battery_indicator"/>
    <origin rpy="0 -0.8 1.5707963267948966" xyz="0.001 0.1075 0.0535"/>
  </joint>
